# Copy to .env.local for local development. Locally, everything is optional:
# without these, the waitlist is saved to ./data/waitlist.db. On Vercel, set them
# in Project → Settings → Environment Variables. See docs/deployment.md.

# ── Waitlist database (required on Vercel) ──────────────────────────────────
# A Turso database. It can be the app's own database: the website only uses
# its own table, waitlist_signups.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ── Waitlist export ──────────────────────────────────────────────────────────
# Turns on /api/waitlist/export (CSV download, asks for this password).
# A long random value, e.g. `openssl rand -base64 24`.
WAITLIST_EXPORT_PASSWORD=

# ── The app at /app-demo ─────────────────────────────────────────────────────
# Where the app-demo Vercel project is deployed, e.g.
# https://sidekick-app-demo.vercel.app. This site then serves the app at
# /app-demo on the same domain. Leave empty to not serve /app-demo.
APP_DEMO_ORIGIN=

# ── App links ────────────────────────────────────────────────────────────────
# Make invite links (trysidekick.ca/invite/…) open the app when it's installed.
# Leave empty until the apps exist. See docs/deployment.md, "6. App links".
# iOS: "<Team ID>.<bundle ID>", e.g. ABCDE12345.ca.trysidekick.app
APPLE_APP_IDS=
# Android: the applicationId, and the SHA-256 fingerprint of the certificate
# that signs the app (Play Console → App signing). Comma-separate several.
ANDROID_PACKAGE_NAME=
ANDROID_CERT_SHA256=

# ── Optional ─────────────────────────────────────────────────────────────────
# Canonical site URL for metadata and the sitemap. Default: https://www.trysidekick.ca
# NEXT_PUBLIC_SITE_URL=
